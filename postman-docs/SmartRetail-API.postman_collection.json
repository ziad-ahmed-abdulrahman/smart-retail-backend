              ],
              "path": [
                "api",
                "accounts",
                "account-activations"
              ]
            },
            "description": "Generates and sends a new one-time activation code (OTP) to the user's email if the previous one expired."
          },
          "response": []
        },
        {
          "name": "Verify Account Activation Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
