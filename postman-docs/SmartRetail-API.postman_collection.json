            },
            "url": {
              "raw": "{{base_url}}/api/accounts/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "accounts",
                "login"
              ]
            },
            "description": "Authenticates the SuperAdmin credentials."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (pm.response.code === 200 && res.data) {",
                  "    if (res.data.token) { pm.environment.set('token', res.data.token); }",
                  "    if (res.data.refreshToken) { pm.environment.set('refresh_token', res.data.refreshToken); }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{token}}\",\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/accounts/refresh-token",
              "host": [
